# --------------------------------------------------------------------------- #
# 0. Network guard: guarantee fully local operation
# --------------------------------------------------------------------------- #
_LOCAL_NAMES = {None, "", "localhost", "127.0.0.1", "::1"}
_real_connect, _real_connect_ex, _real_getaddrinfo = (
    socket.socket.connect, socket.socket.connect_ex, socket.getaddrinfo)


def _addr_is_local(addr) -> bool:
    if isinstance(addr, (str, bytes)):          # AF_UNIX
        return True
    host = addr[0]
    if host in _LOCAL_NAMES:
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def install_network_guard() -> None:
    def connect(self, addr):
        if not _addr_is_local(addr):
            raise PermissionError(f"Blocked non-local connection to {addr!r}")
        return _real_connect(self, addr)

    def connect_ex(self, addr):
        if not _addr_is_local(addr):
            raise PermissionError(f"Blocked non-local connection to {addr!r}")
        return _real_connect_ex(self, addr)

    def getaddrinfo(host, *a, **k):
        if host not in _LOCAL_NAMES and not _addr_is_local((host,)):
            raise PermissionError(f"Blocked DNS lookup for {host!r}")
        return _real_getaddrinfo(host, *a, **k)

    socket.socket.connect, socket.socket.connect_ex = connect, connect_ex
    socket.getaddrinfo = getaddrinfo


