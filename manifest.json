{
  "manifest_version": 3,
  "name": "Minimal Browser Extension",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Extension Popup"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
