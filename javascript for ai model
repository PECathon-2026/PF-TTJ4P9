#!/usr/bin/env node
const fs = require("fs");
const path = require("path");
const axios = require("axios");
const robot = require("robotjs");

const LOG = console;

function ensureLocalOnly(url) {
  try {
    const u = new URL(url);
    const host = u.hostname.toLowerCase();
    const localHosts = ["localhost", "127.0.0.1", "::1", "0.0.0.0"];
    if (!localHosts.includes(host) && !host.startsWith("127.")) {
      throw new Error(`Blocked non-local URL: ${url}`);
    }
  } catch (e) {
    throw e;
  }
}

class PiiDetector {
  constructor() {
    this.patterns = [
      { label: "EMAIL", rx: /[\w.+-]+@[\w-]+\.[\w.-]+/g },
      { label: "UPI", rx: /\b[\w.-]{2,}@[a-z]{2,}\b(?!\.)/gi },
      { label: "PHONE", rx: /(?<!\d)(?:\+91[\s-]?)?[6-9]\d{4}[\s-]?\d{5}(?!\d)/g },
      { label: "AADHAAR", rx: /(?<!\d)[2-9]\d{3}\s?\d{4}\s?\d{4}(?!\d)/g },
      { label: "PAN", rx: /\b[A-Z]{5}\d{4}[A-Z]\b/g },
      { label: "CARD", rx: /(?<!\d)(?:\d[ -]?){13,19}(?!\d)/g },
      { label: "IFSC", rx: /\b[A-Z]{4}0[A-Z0-9]{6}\b/g },
      { label: "IP", rx: /\b(?:\d{1,3}\.){3}\d{1,3}\b/g }
    ];
    this.contextPattern = /\b(password|passcode|pin|otp|cvv|cvc|card number|account number|aadhaar|aadhar|pan|ssn|date of birth|dob|address|phone|mobile|email|salary|diagnosis|secret|api key|token)\b/i;
    this.secretFieldPattern = /\b(password|passcode|pin|otp|cvv|cvc|secret|api key|token)\b/i;
  }

  maskText(text) {
    if (!text) return { masked: "", tags: [] };

    const tags = new Set();
    let result = text;
    const matches = [];

    for (const p of this.patterns) {
      const regex = new RegExp(p.rx.source, p.rx.flags.includes("g") ? p.rx.flags : `${p.rx.flags}g`);
      let m;
      while ((m = regex.exec(text)) !== null) {
        matches.push({
          start: m.index,
          end: m.index + m[0].length,
          label: p.label,
          value: m[0]
        });
      }
    }

    matches.sort((a, b) => b.start - a.start);

    for (const match of matches) {
      const label = match.label;
      tags.add(label);
      result =
        result.slice(0, match.start) +
        `[${label}]` +
        result.slice(match.end);
    }

    return { masked: result, tags: [...tags] };
  }

  isSecretField(text) {
    return !!text && this.secretFieldPattern.test(text);
  }
}

class Element {
  constructor(id, kind, rect, text = "") {
    this.id = id;
    this.kind = kind; // text | control | face
    this.rect = rect; // {x,y,w,h}
    this.text = text;
    this.pii = [];
    this.secretField = false;
    this.safeText = text;
  }

  get center() {
    return {
      x: this.rect.x + this.rect.w / 2,
      y: this.rect.y + this.rect.h / 2
    };
  }
}

class Observation {
  constructor(image, elements) {
    this.image = image;
    this.elements = elements;
    this.width = image ? image.width : 0;
    this.height = image ? image.height : 0;
  }

  byId(id) {
    return this.elements.find((e) => e.id === id) || null;
  }
}

class Perception {
  constructor(detector) {
    this.detector = detector;
  }

  captureScreen() {
    const bitmap = robot.screen.capture(0, 0, robot.getScreenSize().width, robot.getScreenSize().height);
    const image = {
      width: bitmap.width,
      height: bitmap.height,
      data: bitmap.image
    };
    return image;
  }

  perceive() {
    const image = this.captureScreen();
    const elements = [];

    const sampleText = "Open Settings Password 1234";
    const e1 = new Element("e1", "text", { x: 100, y: 80, w: 320, h: 40 }, sampleText);
    const masked = this.detector.maskText(sampleText);
    e1.safeText = masked.masked;
    e1.pii = masked.tags;
    e1.secretField = this.detector.isSecretField(sampleText);
    elements.push(e1);

    const e2 = new Element("e2", "control", { x: 100, y: 150, w: 180, h: 40 }, "Open Settings");
    e2.safeText = "Open Settings";
    elements.push(e2);

    return new Observation(image, elements);
  }
}

class RulePlanner {
  constructor(goal) {
    this.steps = goal.split(";").map((s) => s.trim()).filter(Boolean);
    this.index = 0;
  }

  findTarget(obs, label) {
    const l = label.toLowerCase().trim().replace(/['"]/g, "");
    const cands = obs.elements.filter((e) => e.kind !== "face" && e.text && e.text.toLowerCase().includes(l));
    cands.sort((a, b) => (a.kind !== "control" ? 1 : 0) - (b.kind !== "control" ? 1 : 0));
    return cands[0] ? cands[0].id : null;
  }

  next(goal, obs, history) {
    if (this.index >= this.steps.length) {
      return { action: "done", reason: "all steps finished" };
    }

    const step = this.steps[this.index++];
    const lower = step.toLowerCase();

    if (lower.startsWith("click ")) {
      const targetName = step.substring("click ".length).trim();
      return { action: "click", target: this.findTarget(obs, targetName), reason: step };
    }

    if (lower.startsWith("type ")) {
      // Example: type "hello" into Search
      return { action: "type", text: "hello", target: this.findTarget(obs, "Search"), reason: step };
    }

    if (lower.startsWith("hotkey ")) {
      const keys = step.substring("hotkey ".length).trim().toLowerCase().split("+");
      return { action: "hotkey", keys, reason: step };
    }

    if (lower.startsWith("scroll ")) {
      const n = Number(step.substring("scroll ".length).trim());
      return { action: "scroll", amount: n, reason: step };
    }

    return { action: "wait", seconds: 1, reason: `unknown step: ${step}` };
  }
}

class OllamaPlanner {
  constructor(model = "llama3.1:8b", url = "http://127.0.0.1:11434") {
    ensureLocalOnly(url + "/api/generate");
    this.model = model;
    this.url = url.replace(/\\/$/, "");
  }

  async next(goal, obs, history) {
    const prompt = [
      "You are a desktop UI agent. Reply with JSON only.",
      `Goal: ${goal}`,
      `Recent actions: ${history.slice(-6).join("\\n")}`,
      "Screen elements:",
      ...obs.elements.map((e) => `${e.id}|${e.kind}|${e.safeText || ""}|${e.pii.join(",") || "-"}`),
      ""
    ].join("\\n");

    try {
      const res = await axios.post(`${this.url}/api/generate`, {
        model: this.model,
        prompt,
        stream: false,
        format: "json",
        options: { temperature: 0 }
      }, {
        timeout: 120000
      });

      const text = res.data.response || "";
      const obj = this.extractFirstJson(text);
      if (!obj) return { action: "wait", seconds: 1, reason: "unparseable planner output" };

      try {
        return JSON.parse(obj);
      } catch (err) {
        return { action: "wait", seconds: 1, reason: "invalid JSON from planner" };
      }
    } catch (err) {
      console.error("Ollama planner error:", err.message);
      return { action: "wait", seconds: 1, reason: err.message };
    }
  }

  extractFirstJson(text) {
    const start = text.indexOf("{");
    const end = text.lastIndexOf("}");
    if (start === -1 || end === -1 || end < start) return null;
    return text.substring(start, end + 1);
  }
}

class Validator {
  check(act, obs) {
    const verdict = { ok: true, reasons: [], approval: [] };

    if (!act || typeof act !== "object") {
      verdict.ok = false;
      verdict.reasons.push("action is not an object");
      return verdict;
    }

    const allowed = ["click", "double_click", "right_click", "type", "hotkey", "scroll", "wait", "done"];
    const action = act.action;
    if (!allowed.includes(action)) {
      verdict.ok = false;
      verdict.reasons.push(`unknown action ${action}`);
      return verdict;
    }

    if (act.target) {
      const target = obs.byId(String(act.target));
      if (!target) {
        verdict.ok = false;
        verdict.reasons.push(`target ${act.target} not on screen`);
        return verdict;
      }
      if (target.kind === "face") {
        verdict.ok = false;
        verdict.reasons.push("faces are not interactive targets");
        return verdict;
      }
    }

    if (action === "type") {
      if (!act.text || typeof act.text !== "string") {
        verdict.ok = false;
        verdict.reasons.push("type requires non-empty text");
        return verdict;
      }
      if (act.text.length > 500) {
        verdict.ok = false;
        verdict.reasons.push("text longer than 500 chars");
        return verdict;
      }
      if (act.target) {
        const target = obs.byId(String(act.target));
        if (target && target.secretField) {
          verdict.approval.push("typing into a password/OTP/secret field");
        }
      }
      if (act.text.includes("rm -rf") || act.text.includes("sudo") || act.text.includes("shutdown")) {
        verdict.ok = false;
        verdict.reasons.push("typed text matches dangerous command pattern");
        return verdict;
      }
    }

    if (action === "hotkey") {
      const keys = act.keys;
      if (!Array.isArray(keys) || keys.length < 1 || keys.length > 4) {
        verdict.ok = false;
        verdict.reasons.push("hotkey needs a list of 1-4 key names");
        return verdict;
      }
      const combo = keys.map((k) => String(k).trim().toLowerCase()).join("+");
      if (["alt+f4", "ctrl+alt+delete", "ctrl+shift+esc", "win+r", "win+l"].includes(combo)) {
        verdict.ok = false;
        verdict.reasons.push(`hotkey ${combo} is blocked`);
        return verdict;
      }
    }

    if (action === "scroll") {
      const amount = Number(act.amount);
      if (!Number.isInteger(amount) || amount < -30 || amount > 30) {
        verdict.ok = false;
        verdict.reasons.push("scroll amount must be an int in [-30, 30]");
        return verdict;
      }
    }

    if (action === "wait") {
      const seconds = Number(act.seconds);
      if (!Number.isFinite(seconds) || seconds < 0 || seconds > 10) {
        verdict.ok = false;
        verdict.reasons.push("wait must be 0-10 seconds");
        return verdict;
      }
    }

    return verdict;
  }
}

class Executor {
  constructor(dryRun) {
    this.dryRun = !!dryRun;
  }

  run(act, obs) {
    if (this.dryRun) return;

    const action = act.action;
    if (action === "click") {
      const target = obs.byId(String(act.target));
      if (!target) return;
      const p = target.center;
      robot.moveMouse(p.x, p.y);
      robot.mouseClick();
    } else if (action === "type") {
      if (act.target) {
        const target = obs.byId(String(act.target));
        if (target) {
          const p = target.center;
          robot.moveMouse(p.x, p.y);
          robot.mouseClick();
        }
      }
      typeText(act.text);
    } else if (action === "hotkey") {
      pressHotkey(act.keys);
    } else if (action === "scroll") {
      const amount = Number(act.amount || 0);
      robot.scrollMouse(0, amount * 100);
    } else if (action === "wait") {
      const seconds = Number(act.seconds || 1);
      delay(seconds * 1000);
    }
  }
}

function typeText(text) {
  for (const ch of text) {
    const code = keyCodeForChar(ch);
    if (code) {
      robot.keyTap(code);
    } else {
      robot.typeString(ch);
    }
  }
}

function keyCodeForChar(ch) {
  const map = {
    "\n": "enter",
    "\t": "tab",
    " ": "space"
  };
  return map[ch] || null;
}

function pressHotkey(keys) {
  for (const key of keys) {
    robot.keyToggle(key, "down");
  }
  for (const key of keys.slice().reverse()) {
    robot.keyToggle(key, "up");
  }
}

function delay(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

async function askApproval(act, reasons) {
  console.log("\nAPPROVAL REQUIRED");
  console.log("Action:", JSON.stringify(act));
  console.log("Reasons:");
  for (const r of reasons) console.log(" -", r);

  const answer = await new Promise((resolve) => {
    process.stdin.resume();
    process.stdin.once("data", (d) => resolve(String(d).trim().toLowerCase()));
  });

  return answer === "y" || answer === "yes";
}

class Agent {
  constructor(perception, planner, validator, executor, outDir = "agent_runs") {
    this.perception = perception;
    this.planner = planner;
    this.validator = validator;
    this.executor = executor;
    this.outDir = outDir;
    fs.mkdirSync(outDir, { recursive: true });
    this.history = [];
  }

  async run(goal) {
    let rejections = 0;
    const maxSteps = 15;
    for (let step = 1; step <= maxSteps; step++) {
      const obs = this.perception.perceive();
      try {
        const act = await this.planner.next(goal, obs, this.history);
        if (!act || act.action === "done") {
          console.log("Done:", act && act.reason ? act.reason : "goal completed");
          return;
        }

        const verdict = this.validator.check(act, obs);
        if (!verdict.ok) {
          rejections++;
          const msg = `REJECTED ${JSON.stringify(act)}: ${verdict.reasons.join("; ")}`;
          this.history.push(msg);
          if (rejections >= 3) {
            console.log("Too many rejected actions - aborting.");
            return;
          }
          continue;
        }

        if (verdict.approval.length > 0) {
          const approved = await askApproval(act, verdict.approval);
          if (!approved) {
            this.history.push(`USER DENIED ${JSON.stringify(act)}`);
            continue;
          }
        }

        this.executor.run(act, obs);
        this.history.push(`OK ${JSON.stringify(act)}`);
        await delay(600);
      } catch (e) {
        console.error("Agent error:", e.message);
        return;
      }
    }
  }
}

async function main() {
  const args = process.argv.slice(2);
  const goal = args[0] || "click File; click Open";
  const plannerType = args[1] || "rule";
  const dryRun = args.includes("--dry-run");

  const detector = new PiiDetector();
  const perception = new Perception(detector);
  const planner = plannerType === "ollama"
    ? new OllamaPlanner("llama3.1:8b", "http://127.0.0.1:11434")
    : new RulePlanner(goal);

  const agent = new Agent(
    perception,
    planner,
    new Validator(),
    new Executor(dryRun),
    "agent_runs"
  );

  await agent.run(goal);
}

main().catch((err) => {
  console.error("Fatal error:", err.message);
  process.exit(1);
});
